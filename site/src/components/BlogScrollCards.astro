---
interface Post {
  href: string;
  title: string;
  author?: string;
  excerpt: string;
}

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

const tilts = [-3, 2, -2, 3, -2.5, 1.5];
const accentVars = ['--color-primary', '--color-secondary', '--color-accent'];
---

<div class="blog-cards-track grid gap-8 py-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    posts.map((post, i) => {
      const accentVar = accentVars[i % accentVars.length];
      const tilt = tilts[i % tilts.length];
      return (
        <a
          href={post.href}
          class="blog-card group relative flex flex-col gap-3 bg-surface p-6 shadow-md"
          style={`--tilt: ${tilt}deg; --i: ${i}; --card-accent: var(${accentVar});`}
        >
          <span class="blog-card-pin" style="background-color: var(--card-accent);" aria-hidden="true" />
          <span class="h-1 w-10" style="background-color: var(--card-accent);" aria-hidden="true" />
          {post.author && <p class="kicker text-muted">By {post.author}</p>}
          <h3 class="font-display text-xl font-semibold leading-snug text-paper">{post.title}</h3>
          <p class="line-clamp-3 text-sm text-muted">{post.excerpt}</p>
          <span
            class="mt-auto text-sm font-semibold opacity-0 transition-opacity duration-300 group-hover:opacity-100"
            style="color: var(--card-accent);"
          >
            Read the piece &rarr;
          </span>
        </a>
      );
    })
  }
</div>

<style>
  .blog-cards-track {
    overflow: visible;
  }

  .blog-card {
    opacity: 0;
    transform: translateY(48px) rotate(var(--tilt)) scale(0.94);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.7s ease, box-shadow 0.3s ease;
    transition-delay: calc(var(--i) * 90ms);
    will-change: transform, opacity;
  }

  .blog-card.is-visible {
    opacity: 1;
    transform: translateY(var(--parallax, 0px)) rotate(var(--tilt)) scale(1);
  }

  .blog-card.is-visible:hover {
    transform: translateY(calc(var(--parallax, 0px) - 8px)) rotate(0deg) scale(1.035);
    box-shadow: 0 20px 32px -12px rgba(0, 0, 0, 0.28);
  }

  .blog-card-pin {
    position: absolute;
    top: -0.5rem;
    left: 1.5rem;
    height: 1rem;
    width: 1rem;
    border-radius: 9999px;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.25);
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card {
      transition: none;
      transform: rotate(var(--tilt));
      opacity: 1;
    }
    .blog-card.is-visible:hover {
      transform: rotate(0deg);
    }
  }
</style>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.blog-card'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduceMotion) {
    cards.forEach((card) => card.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );
    cards.forEach((card) => observer.observe(card));

    let ticking = false;
    const updateParallax = () => {
      const viewportMid = window.innerHeight / 2;
      cards.forEach((card, i) => {
        const rect = card.getBoundingClientRect();
        const cardMid = rect.top + rect.height / 2;
        const distance = (cardMid - viewportMid) / viewportMid;
        const speed = 10 + i * 6;
        card.style.setProperty('--parallax', `${(-distance * speed).toFixed(1)}px`);
      });
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(updateParallax);
          ticking = true;
        }
      },
      { passive: true }
    );
    updateParallax();
  }
</script>
