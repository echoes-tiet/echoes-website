---
interface Issue {
  href: string;
  title: string;
  blurb?: string;
  cover?: string;
}

interface Props {
  issues: Issue[];
}

const { issues } = Astro.props;

const tiltsY = [-10, 8, -8, 10];
const accentVars = ['--color-accent', '--color-primary', '--color-secondary'];
---

<div class="newsletter-cards-track grid gap-8 py-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    issues.map((issue, i) => {
      const accentVar = accentVars[i % accentVars.length];
      const tiltY = tiltsY[i % tiltsY.length];
      return (
        <a
          href={issue.href}
          class="newsletter-card group relative flex flex-col border border-black/10 bg-surface shadow-md"
          style={`--tilt-y: ${tiltY}deg; --i: ${i}; --card-accent: var(${accentVar});`}
        >
          <span class="newsletter-card-tag absolute right-0 top-4 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-ink" style="background-color: var(--card-accent);">
            Issue
          </span>

          {issue.cover && (
            <div class="flex justify-center bg-surface-2 p-5">
              <img src={issue.cover} alt="" loading="lazy" class="max-h-56 w-auto object-contain" />
            </div>
          )}

          <div class="flex flex-1 flex-col gap-2 p-5">
            <h3 class="font-display text-lg font-semibold leading-snug text-paper">{issue.title}</h3>
            {issue.blurb && <p class="line-clamp-2 text-sm text-muted">{issue.blurb}</p>}
            <span
              class="mt-auto pt-2 text-sm font-semibold opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              style="color: var(--card-accent);"
            >
              Read the issue &rarr;
            </span>
          </div>
        </a>
      );
    })
  }
</div>

<style>
  .newsletter-cards-track {
    overflow: visible;
    perspective: 1200px;
  }

  .newsletter-card {
    opacity: 0;
    transform: translateY(48px) rotateY(var(--tilt-y)) scale(0.94);
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.7s ease, box-shadow 0.3s ease;
    transition-delay: calc(var(--i) * 90ms);
    will-change: transform, opacity;
  }

  .newsletter-card.is-visible {
    opacity: 1;
    transform: translateY(var(--parallax, 0px)) rotateY(var(--tilt-y)) scale(1);
  }

  .newsletter-card.is-visible:hover {
    transform: translateY(calc(var(--parallax, 0px) - 8px)) rotateY(0deg) scale(1.035);
    box-shadow: 0 20px 32px -12px rgba(0, 0, 0, 0.28);
  }

  .newsletter-card-tag {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 12px 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .newsletter-card {
      transition: none;
      transform: rotateY(0deg);
      opacity: 1;
    }
    .newsletter-card.is-visible:hover {
      transform: none;
    }
  }
</style>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.newsletter-card'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduceMotion) {
    cards.forEach((card) => card.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );
    cards.forEach((card) => observer.observe(card));

    let ticking = false;
    const updateParallax = () => {
      const viewportMid = window.innerHeight / 2;
      cards.forEach((card, i) => {
        const rect = card.getBoundingClientRect();
        const cardMid = rect.top + rect.height / 2;
        const distance = (cardMid - viewportMid) / viewportMid;
        const speed = 8 + i * 5;
        card.style.setProperty('--parallax', `${(-distance * speed).toFixed(1)}px`);
      });
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(updateParallax);
          ticking = true;
        }
      },
      { passive: true }
    );
    updateParallax();
  }
</script>
