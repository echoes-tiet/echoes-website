---
const socials = [
  { label: 'Facebook', href: 'https://www.facebook.com/echoestiet-650396715635915/' },
  { label: 'Instagram', href: 'https://www.instagram.com/echoes.tiet/' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/echoes-t-i-e-t/?viewAsMember=true' },
  { label: 'Email', href: 'mailto:echoes@thapar.edu' },
];
---

<footer class="border-t-4 border-double border-paper/70 bg-surface">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-14 md:grid-cols-3">
    <div>
      <p class="font-display text-2xl italic text-paper">Echoes.</p>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        Thapar Institute of Engineering &amp; Technology<br />
        Patiala &ndash; 147004, Punjab
      </p>
    </div>

    <div>
      <p class="kicker text-muted">Follow</p>
      <ul class="mt-3 space-y-1.5">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium text-paper transition-colors hover:text-primary hover:underline"
              >
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="border border-paper/15">
      <iframe
        title="Thapar Institute of Engineering & Technology location"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3442.931076204095!2d76.36136906517636!3d30.352908660889383!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39102f534a87b5c5%3A0xda1d3ed337e382b3!2sThapar%20University%2C%20Prem%20Nagar%2C%20Patiala%2C%20Punjab%20147004!5e0!3m2!1sen!2sin!4v1651865124713!5m2!1sen!2sin"
        style="border:0; width: 100%; height: 100%;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>

  <div class="border-t border-paper/15 py-6 text-center text-xs text-muted">
    &copy; {new Date().getFullYear()} Echoes, TIET. All rights reserved.
  </div>
</footer>
