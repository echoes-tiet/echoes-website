---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';

const images = [
  '/images/gallery/10.png',
  '/images/gallery/3.png',
  '/images/gallery/7.jpg',
  '/images/gallery/5.jpg',
  '/images/gallery/11.png',
  '/images/gallery/1.png',
  '/images/gallery/scene00026.png',
  '/images/gallery/8.jpg',
  '/images/gallery/6.jpg',
  '/images/gallery/9.png',
  '/images/gallery/4.jpg',
  '/images/gallery/2.jpg',
];
---

<Layout title="Gallery — Echoes" description="Moments captured by the Echoes team around campus.">
  <PageHero eyebrow="Gallery" title="Moments, captured" subtitle="“The camera sees more than the eye, so why not make use of it?” — Edward Weston" />

  <section class="mx-auto max-w-7xl columns-1 gap-4 px-5 py-14 sm:columns-2 lg:columns-3">
    {
      images.map((src) => (
        <img
          src={src}
          alt=""
          loading="lazy"
          class="mb-4 w-full border border-black/10 object-cover"
        />
      ))
    }
  </section>
</Layout>
