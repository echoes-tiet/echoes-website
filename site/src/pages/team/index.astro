---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';

const members = await getCollection('members');
const sections = ['Faculty', 'Executive Board', 'Core'] as const;

const bySection = Object.fromEntries(
  sections.map((section) => [
    section,
    members.filter((m) => m.data.section === section).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)),
  ])
);

const socialIcon: Record<string, string> = {
  instagram: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"/></svg>`,
  linkedin: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="17" height="17" rx="3"/><line x1="7.6" y1="10.2" x2="7.6" y2="16.6"/><circle cx="7.6" cy="7" r="0.75" fill="currentColor" stroke="none"/><path d="M11.4 16.6v-4.1a2.3 2.3 0 0 1 4.6 0v4.1"/><line x1="11.4" y1="10.2" x2="11.4" y2="16.6"/></svg>`,
  facebook: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.6 1.6-1.6h1.4V4.9c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8V11H9.2v3h2.4v7z"/></svg>`,
  link: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="8 7 17 7 17 16"/></svg>`,
};
---

<Layout title="Team — Echoes" description="Meet the faculty, executive board, and core team behind Echoes.">
  <PageHero eyebrow="Team" title="The people behind Echoes" subtitle="Faculty, executive board, and the core team." />

  <div class="mx-auto max-w-7xl space-y-16 px-5 py-14">
    {
      sections.map((section) => (
        <section>
          <h2 class="font-display text-2xl italic text-secondary">{section}</h2>
          <div
            class:list={[
              'mt-6 gap-x-6 gap-y-8',
              bySection[section].length < 4
                ? 'flex flex-wrap justify-center'
                : 'grid sm:grid-cols-2 lg:grid-cols-4',
            ]}
          >
            {bySection[section].map((member) => (
              <div
                class:list={[
                  'border-t-2 border-paper/80 pt-3 text-center',
                  bySection[section].length < 4 && 'w-full sm:w-[calc(50%-12px)] lg:w-[calc(25%-18px)]',
                ]}
              >
                {member.data.photo ? (
                  <img src={member.data.photo} alt="" loading="lazy" class="mx-auto aspect-square w-full object-cover" />
                ) : (
                  <div class="mx-auto flex aspect-square w-full items-center justify-center bg-surface-2 font-display text-3xl text-muted">
                    {member.data.name.charAt(0)}
                  </div>
                )}
                <p class="mt-3 font-display font-semibold text-paper">{member.data.name}</p>
                {member.data.role && <p class="font-display text-sm italic text-muted">{member.data.role}</p>}
                {member.data.socials && member.data.socials.length > 0 && (
                  <div class="mt-2 flex justify-center gap-3">
                    {member.data.socials.map((s) => (
                      <a
                        href={s.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={s.platform}
                        class="text-muted transition-colors hover:text-primary"
                      >
                        <span class="block h-4 w-4" set:html={socialIcon[s.platform] ?? socialIcon.link} />
                      </a>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Layout>
