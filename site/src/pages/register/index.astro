---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';

const registrationOptions = [
  {
    title: 'Register here for any upcoming event hosted by Echoes',
  },
];
---

<Layout title="Registration — Echoes" description="Register for upcoming events hosted by Echoes.">
  <PageHero eyebrow="Registration" title="Registrations" subtitle="Register for events, workshops, photowalks, all right here." />

  <section class="mx-auto max-w-3xl space-y-10 px-5 py-20">
    {
      registrationOptions.map((option) => (
        <div class="border border-paper/15 p-10 text-center sm:p-16">
          <p class="kicker text-primary">Echoes</p>
          <h2 class="mt-3 font-display text-3xl text-paper sm:text-4xl">{option.title}</h2>
          <div class="mx-auto mt-6 max-w-sm border-t-4 border-double border-paper/70" />
          <p class="kicker mt-9 text-muted">Coming soon</p>
        </div>
      ))
    }
  </section>
</Layout>
