---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout title="Registration — Echoes" description="Registration for Echoes is open — register now.">
  <PageHero eyebrow="Registration" title="Registrations are open" subtitle="Full details for this page are on their way." />

  <section class="mx-auto max-w-3xl px-5 py-20">
    <div class="border border-paper/15 p-10 text-center sm:p-16">
      <p class="kicker text-primary">Echoes</p>
      <h2 class="mt-3 font-display text-3xl text-paper sm:text-4xl">Ready to be a part of it?</h2>
      <div class="mx-auto mt-6 max-w-sm border-t-4 border-double border-paper/70"></div>
      <p class="mx-auto mt-6 max-w-lg text-muted">
        We're putting the finishing touches on this page — the full rundown of what's on offer will land here soon.
        For now, secure your spot through the registration form below.
      </p>
      <a
        href="https://forms.gle/aVp6fygTsHkVtafC7"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary mt-9 inline-flex"
      >
        Register Now
      </a>
    </div>
  </section>
</Layout>
