---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';

const registrationOptions = [
  {
    title: 'Orientation',
    description:
      'Register for the orientation to know more about the club and have a fun evening which will be hard to forget.',
    formUrl: 'https://docs.google.com/forms/d/e/1FAIpQLSdNTJjex0kXs4GDk6-q-Y-sEa_ZhAIHc5c0FUHiRPz6EOA2jg/viewform?usp=publish-editor',
  },
];
---

<Layout title="Registration — Echoes" description="Registration for Echoes is open — register now.">
  <PageHero eyebrow="Registration" title="Registrations are open" subtitle="Full details for this page are on their way." />

  <section class="mx-auto max-w-3xl space-y-10 px-5 py-20">
    {
      registrationOptions.map((option) => (
        <div class="border border-paper/15 p-10 text-center sm:p-16">
          <p class="kicker text-primary">Echoes</p>
          <h2 class="mt-3 font-display text-3xl text-paper sm:text-4xl">{option.title}</h2>
          <div class="mx-auto mt-6 max-w-sm border-t-4 border-double border-paper/70" />
          <p class="mx-auto mt-6 max-w-lg text-muted">{option.description}</p>
          <a href={option.formUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-9 inline-flex">
            Register Now
          </a>
        </div>
      ))
    }
  </section>
</Layout>
