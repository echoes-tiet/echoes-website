---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const editions = await getCollection('editions');
  return editions.map((edition) => ({ params: { slug: edition.id }, props: { edition } }));
}

const { edition } = Astro.props;
---

<Layout title={`Edition ${edition.data.number} — Echoes`}>
  <div class="mx-auto max-w-5xl px-5 py-16">
    <a href="/editions/" class="text-sm font-semibold text-accent hover:underline">&larr; All editions</a>

    <p class="mt-4 font-display text-sm font-semibold uppercase tracking-[0.3em] text-secondary">
      Edition {edition.data.number}
    </p>
    <h1 class="mt-2 font-display text-4xl font-bold text-paper md:text-5xl">{edition.data.subtitle}</h1>
    {edition.data.blurb && <p class="mt-4 max-w-2xl text-muted">{edition.data.blurb}</p>}

    {
      edition.data.embedUrl && (
        <div class="mt-10 overflow-hidden border border-black/10 bg-surface">
          <iframe
            src={edition.data.embedUrl}
            title={`Edition ${edition.data.number}`}
            class="h-[80vh] w-full"
            allowfullscreen
            allowtransparency
          />
        </div>
      )
    }
  </div>
</Layout>
