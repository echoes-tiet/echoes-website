---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import EditionsFlowGrid from '../../components/EditionsFlowGrid.astro';

const editions = (await getCollection('editions')).sort((a, b) => b.data.number - a.data.number);
---

<Layout title="Editions — Echoes" description="Every issue of the Echoes magazine, TIET's student panorama.">
  <PageHero eyebrow="Editions" title="The Echoes magazine, issue by issue" subtitle="Our full-length editions, cover to cover." />

  <section class="mx-auto max-w-7xl px-5 py-14">
    <EditionsFlowGrid
      editions={editions.map((edition) => ({
        href: `/editions/${edition.id}/`,
        number: edition.data.number,
        title: edition.data.subtitle ?? `Edition ${edition.data.number}`,
        cover: edition.data.cover,
        blurb: edition.data.blurb,
      }))}
    />
  </section>
</Layout>
