---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Cascade Team Registration — Echoes" description="Team registration for Cascade, an Echoes event.">
  <section
    class="bg-cover bg-center px-5 py-20"
    style="background-image: linear-gradient(rgba(14,11,20,0.85), rgba(14,11,20,0.85)), url('/images/brand/background.png');"
  >
    <div class="mx-auto max-w-lg border border-paper/15 bg-surface p-8">
      <img src="/images/brand/cascade-name.png" alt="Cascade" class="mx-auto mb-6 w-full max-w-xs" />

      <form name="Cascade" action="post" class="space-y-5">
        <div>
          <label class="mb-1 block text-sm font-medium text-muted">Team Name</label>
          <input type="text" name="TeamName" required class="w-full border border-black/15 bg-surface-2 px-4 py-2.5 text-paper focus:border-primary focus:outline-none" />
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-muted">Team Leader's Name</label>
          <input type="text" name="TeamLName" required class="w-full border border-black/15 bg-surface-2 px-4 py-2.5 text-paper focus:border-primary focus:outline-none" />
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-muted">Team Leader's Email</label>
          <input type="email" name="TeamLEmail" required class="w-full border border-black/15 bg-surface-2 px-4 py-2.5 text-paper focus:border-primary focus:outline-none" />
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-muted">Team Leader's Phone Number</label>
          <input type="number" name="TeamLPhoneNumber" required class="w-full border border-black/15 bg-surface-2 px-4 py-2.5 text-paper focus:border-primary focus:outline-none" />
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-muted">Number Of Members (Max 4)</label>
          <input type="number" name="NumbeOfMembers" required class="w-full border border-black/15 bg-surface-2 px-4 py-2.5 text-paper focus:border-primary focus:outline-none" />
        </div>

        <div id="memberDetails" class="space-y-4"></div>

        <button
          type="button"
          class="AddMember w-full btn btn-outline py-2.5 font-display font-semibold text-paper transition-colors hover:border-accent hover:text-accent"
        >
          Add Member
        </button>
        <button
          type="submit"
          class="btn btn-primary w-full"
        >
          Submit
        </button>
      </form>
    </div>
  </section>

  <script is:inline>
    function addMember() {
      const memberDetailsContainer = document.getElementById('memberDetails');
      const addMemberButton = document.querySelector('.AddMember');
      if (memberDetailsContainer.children.length < 4) {
        const memberNumber = memberDetailsContainer.children.length + 1;
        const memberSection = document.createElement('div');
        memberSection.className = 'space-y-3 border-t-2 border-paper/60 pt-3';
        memberSection.innerHTML = `
          <h2 class="font-display font-semibold text-secondary">Member ${memberNumber} Details</h2>
          <div>
            <label class="mb-1 block text-sm font-medium text-muted">First Name</label>
            <input type="text" name="M${memberNumber}Fname" required class="w-full border border-black/15 bg-surface-2 px-4 py-2.5 text-paper focus:border-primary focus:outline-none" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-muted">Last Name</label>
            <input type="text" name="M${memberNumber}LastName" required class="w-full border border-black/15 bg-surface-2 px-4 py-2.5 text-paper focus:border-primary focus:outline-none" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-muted">Email</label>
            <input type="email" name="M${memberNumber}Email" required class="w-full border border-black/15 bg-surface-2 px-4 py-2.5 text-paper focus:border-primary focus:outline-none" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-muted">Phone Number</label>
            <input type="number" name="M${memberNumber}PhoneNumber" required class="w-full border border-black/15 bg-surface-2 px-4 py-2.5 text-paper focus:border-primary focus:outline-none" />
          </div>
          <button class="RemoveMember btn btn-outline px-4 py-2 text-sm text-paper hover:border-primary hover:text-primary" type="button">Remove Member</button>
        `;
        memberSection.querySelector('.RemoveMember').addEventListener('click', () => removeMember(memberSection));
        memberDetailsContainer.appendChild(memberSection);
      }
      if (memberDetailsContainer.children.length === 4) {
        addMemberButton.style.display = 'none';
      }
    }

    function removeMember(memberSection) {
      const memberDetailsContainer = document.getElementById('memberDetails');
      const addMemberButton = document.querySelector('.AddMember');
      memberDetailsContainer.removeChild(memberSection);

      const remainingMembers = memberDetailsContainer.children;
      for (let i = 0; i < remainingMembers.length; i++) {
        const currentMember = remainingMembers[i];
        const memberNumber = i + 1;
        currentMember.querySelector('h2').innerText = `Member ${memberNumber} Details`;
        currentMember.querySelectorAll('input').forEach((input) => {
          const currentName = input.getAttribute('name');
          input.setAttribute('name', currentName.replace(/\d+/, memberNumber));
        });
      }
      addMemberButton.style.display = 'block';
    }

    document.querySelector('.AddMember').addEventListener('click', addMember);

    const scriptURL =
      'https://script.google.com/macros/s/AKfycbyl_idQyVq6lW6umC5Dg0dEXQoPs2DDakHOmyGyzcu7UJ6mNk_SaXWEcTCPo_Vveh4V/exec';
    const form = document.forms['Cascade'];

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      fetch(scriptURL, { method: 'POST', body: new FormData(form) })
        .then(() => alert('Thank you! your form is submitted successfully.'))
        .then(() => window.location.reload())
        .catch((error) => console.error('Error!', error.message));
    });
  </script>
</Layout>
